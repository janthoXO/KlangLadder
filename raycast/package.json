{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "klangladder",
  "title": "KlangLadder",
  "description": "Open KlangLadder, the menu bar app that switches macOS audio devices by priority.",
  "icon": "icon.png",
  "author": "janthoxo",
  "categories": [
    "System"
  ],
  "license": "MIT",
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "open",
      "title": "Open KlangLadder",
      "description": "Open the KlangLadder popover.",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.4.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
